---
// Photo slot. Until the client's photographs arrive it renders a calm placeholder.
// In draft mode (PUBLIC_DRAFT=true) the placeholder shows the shot ID + brief for client review.
import { isDraft } from '../data/site';
import Logo from './Logo.astro';
interface Props {
  shot: string;            // shot-list ID, e.g. "P1"
  brief: string;           // what the photograph must show (also the alt text)
  ratio?: string;          // CSS aspect-ratio, e.g. "4 / 5"
  src?: string;            // real image when available
  round?: boolean;         // circular plate crop
  class?: string;
  eager?: boolean;
  reveal?: 'wipe' | 'settle';  // scroll reveal (see Reveal.astro)
}
const { shot, brief, ratio = '4 / 3', src, round = false, class: cls = '', eager = false, reveal } = Astro.props;
---
<figure class:list={['photo', { 'photo--round': round }, cls]} style={`--ratio:${ratio}`} data-shot={shot} data-reveal={reveal}>
  {src ? (
    <img src={src} alt={brief} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="photo__ph" role="img" aria-label={brief}>
      {isDraft ? (
        <>
          <svg class="photo__glyph" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="24" r="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3"/></svg>
          <span class="photo__tag"><b>{shot}</b> {brief}</span>
        </>
      ) : (
        <Logo variant="mark" class="photo__mark" />
      )}
    </div>
  )}
</figure>
<style>
  .photo { position: relative; aspect-ratio: var(--ratio); border-radius: var(--r-card); overflow: hidden; background: var(--menta-200); isolation: isolate; }
  .photo--round { border-radius: 50%; }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .photo__ph {
    position: absolute; inset: 0; display: grid; place-items: center; color: var(--patrunjel-300);
    background: var(--menta-200);
  }
  .photo__glyph { width: clamp(36px, 18%, 72px); }
  /* Live site without the photo yet: a quiet brand mark instead of an "image missing" glyph */
  .photo__ph :global(.photo__mark) { width: clamp(40px, 22%, 96px); aspect-ratio: 1; color: var(--patrunjel-300); opacity: 0.55; }
  .photo__tag {
    position: absolute; left: 12px; right: 12px; bottom: 12px; font-size: 12px; line-height: 1.35;
    color: var(--patrunjel); background: rgb(255 249 238 / 0.85); padding: 6px 10px; border-radius: 8px;
  }
  .photo--round .photo__tag { left: 18%; right: 18%; bottom: 18%; text-align: center; }
  :global(a:hover) > .photo img, :global(a:hover) .photo img { transform: scale(1.03); }
</style>
