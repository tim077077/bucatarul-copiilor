---
import horizontal from '../assets/logo/horizontal.svg?raw';
import mark from '../assets/logo/mark.svg?raw';
import stacked from '../assets/logo/stacked.svg?raw';
interface Props { variant?: 'horizontal' | 'mark' | 'stacked'; class?: string }
const { variant = 'horizontal', class: cls = '' } = Astro.props;
const svg = { horizontal, mark, stacked }[variant];
---
<span class={`logo logo--${variant} ${cls}`} set:html={svg} />
<style>
  .logo { display: inline-block; color: currentColor; line-height: 0; }
  .logo :global(svg) { width: 100%; height: 100%; }
</style>
