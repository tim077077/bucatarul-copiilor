---
import { faqs, type Faq } from '../data/faq';
import { isDraft } from '../data/site';
interface Props { tag?: string; withSchema?: boolean; collapseAfter?: number }
// collapseAfter: on phones (with JS) show only the first N questions plus a "show all" button.
const { tag, collapseAfter } = Astro.props;
const list: Faq[] = faqs.filter((f) => (!tag || f.tags.includes(tag)) && (f.confirmed || isDraft));
const collapsible = !!collapseAfter && list.length > collapseAfter + 1;
---
<div class="faq" data-faq={collapsible ? 'collapsible' : undefined}>
  {list.map((f, i) => (
    <details class:list={['faq__item', { 'faq__item--draft': !f.confirmed, 'faq__item--more': collapsible && i >= collapseAfter! }]} name="faq">
      <summary><span>{f.q}</span><span class="faq__sign" aria-hidden="true"></span></summary>
      <div class="faq__a"><div><p>{f.a}</p></div></div>
    </details>
  ))}
  {collapsible && (
    <button type="button" class="faq__more" aria-expanded="false">Vezi toate întrebările ({list.length})</button>
  )}
</div>
<style>
  .faq { border-top: 1px solid var(--line-strong); }
  .faq__item { border-bottom: 1px solid var(--line-strong); }
  .faq__item--draft summary span:first-child::after { content: ' · de confirmat'; color: var(--rosie); font-family: var(--font-body); font-size: 0.8rem; }
  summary {
    list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--s-5);
    padding: var(--s-5) 0; cursor: pointer; font-family: var(--font-display); font-size: var(--step-1); color: var(--ink-head); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--rosie); }
  .faq__sign { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--menta); transition: background-color var(--t-base), transform var(--t-base) var(--ease-out); }
  .faq__sign::before, .faq__sign::after { content: ''; position: absolute; left: 11px; right: 11px; top: 17px; height: 2px; background: var(--patrunjel); border-radius: 2px; transition: transform var(--t-base) var(--ease-out); }
  .faq__sign::after { transform: rotate(90deg); }
  details[open] .faq__sign { background: var(--rosie); }
  details[open] .faq__sign::before, details[open] .faq__sign::after { background: #fff; }
  details[open] .faq__sign::after { transform: rotate(0deg); }
  .faq__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 260ms var(--ease-out); }
  details[open] .faq__a { grid-template-rows: 1fr; }
  .faq__a > div { overflow: hidden; }
  .faq__a p { padding-bottom: var(--s-5); color: var(--ink); max-width: 62ch; }
  /* Smooth open where supported */
  @supports (interpolate-size: allow-keywords) {
    .faq { interpolate-size: allow-keywords; }
    details::details-content { height: 0; overflow: clip; transition: height 260ms var(--ease-out), content-visibility 260ms allow-discrete; }
    details[open]::details-content { height: auto; }
  }

  /* Phone collapse: armed by JS only, so without JS every question stays visible */
  .faq__more { display: none; }
  @media (max-width: 760px) {
    .faq.is-collapsed .faq__item--more { display: none; }
    .faq.is-collapsed .faq__more {
      display: inline-flex; align-items: center; min-height: 48px; margin-top: var(--s-5); padding: 0 var(--s-5);
      border: 2px solid var(--patrunjel); border-radius: var(--r-pill); background: transparent;
      color: var(--patrunjel); font-weight: 700; font-size: 0.9375rem;
    }
    .faq.is-collapsed .faq__more:hover { background: var(--menta); }
  }
</style>

<script>
  function initFaq() {
    document.querySelectorAll<HTMLElement>('[data-faq=collapsible]').forEach((faq) => {
      if (faq.dataset.ready) return;
      faq.dataset.ready = '1';
      faq.classList.add('is-collapsed');
      const btn = faq.querySelector<HTMLButtonElement>('.faq__more')!;
      btn.addEventListener('click', () => {
        faq.classList.remove('is-collapsed');
        btn.setAttribute('aria-expanded', 'true');
        faq.querySelector<HTMLElement>('.faq__item--more summary')?.focus();
      });
    });
  }
  document.addEventListener('astro:page-load', initFaq);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFaq); else initFaq();
</script>
