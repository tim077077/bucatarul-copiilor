---
interface Props { href?: string; variant?: 'primary' | 'light' | 'ghost'; size?: 'md' | 'lg'; type?: 'button' | 'submit'; class?: string; [k: string]: any }
const { href, variant = 'primary', size = 'md', type = 'button', class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]} {...rest}><slot /></Tag>
<style>
  .btn {
    --bg: var(--rosie); --fg: #fff; --bg-h: var(--rosie-700);
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 48px; padding: 0.75rem 1.5rem; border-radius: var(--r-pill); border: 0;
    background: var(--bg); color: var(--fg); font-weight: 700; font-size: 1rem; line-height: 1.1;
    text-decoration: none; white-space: nowrap;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), 0 6px 16px -6px rgb(176 47 27 / 0.45);
    transition: background-color var(--t-fast), transform var(--t-fast) var(--ease-out), box-shadow var(--t-base) var(--ease-out);
  }
  .btn:hover { background: var(--bg-h); color: var(--fg); transform: translateY(-1px); box-shadow: 0 1px 0 rgb(0 0 0 / 0.08), 0 10px 22px -8px rgb(176 47 27 / 0.55); }
  .btn:active { transform: translateY(0) scale(0.98); box-shadow: 0 1px 0 rgb(0 0 0 / 0.08); }
  .btn--lg { min-height: 56px; padding: 1rem 1.75rem; font-size: 1.0625rem; }
  .btn--light { --bg: var(--lapte); --fg: var(--patrunjel); --bg-h: #fff; box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.35); }
  .btn--ghost { --bg: transparent; --fg: var(--patrunjel); --bg-h: var(--menta); box-shadow: inset 0 0 0 2px var(--patrunjel); }
  .btn--ghost:hover { box-shadow: inset 0 0 0 2px var(--patrunjel); }
  .btn :global(.icon) { flex: none; }
</style>
