# Bucătarul copiilor: static site on cPanel (LiteSpeed/Apache)
Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# One address: https://www.bucatarulcopiilor.ro
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^bucatarulcopiilor\.ro$ [NC]
RewriteRule ^(.*)$ https://www.bucatarulcopiilor.ro/$1 [R=301,L]

# Old WordPress addresses go home
RewriteRule ^(landing|feed|comments|wp-admin|wp-login\.php|xmlrpc\.php)(/.*)?$ / [R=301,L]

# /pagina.html -> /pagina (clean URLs)
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# /pagina -> pagina.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# Hashed assets never change; pages always revalidate
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
